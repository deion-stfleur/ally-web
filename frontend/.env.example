# Create React App: only variables prefixed with REACT_APP_ are exposed to the browser.
# OAuth web client: add each frontend origin to Authorized JavaScript origins and the
# same origin (no path) to Authorized redirect URIs (GIS popup code flow).
# Scopes include drive.readonly, drive.file, documents, spreadsheets, presentations,
# calendar, gmail.readonly, gmail.send — add all in Cloud Console OAuth consent + re-login.
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_API_BASE_URL=http://localhost:8000
# Set to true on Netlify while Google OAuth verification is pending.
REACT_APP_WAITLIST_MODE=false
# Calendly (or similar) for /{slug} outreach pages
REACT_APP_OUTREACH_BOOKING_URL=https://calendly.com/yourfriendally/15min
# PostHog analytics — Project API key from posthog.com project settings (phc_...)
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com
