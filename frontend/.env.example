# Create React App: only variables prefixed with REACT_APP_ are exposed to the browser.
# OAuth web client: add http://localhost:3000 to Authorized JavaScript origins and
# add "postmessage" to Authorized redirect URIs (GIS popup code flow).
# Scopes include drive.readonly, drive.file, documents, spreadsheets, presentations,
# calendar, gmail.modify — add all in Cloud Console OAuth consent + re-login.
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_API_BASE_URL=http://localhost:8000
