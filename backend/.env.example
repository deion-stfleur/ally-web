# Phase 1: Postgres — Heroku: add-on sets DATABASE_URL automatically.
# Local Postgres.app: postgresql://127.0.0.1:5432/DBNAME (create DB with createdb).
# With user/password: postgresql://USER:PASS@127.0.0.1:5432/DBNAME
# SQLAlchemy uses asyncpg (postgresql+asyncpg://); code normalizes postgres:// URLs.
DATABASE_URL=

# Scheduled jobs (e.g. "send this email in 10 minutes"): run worker.py in a second terminal
# with the same env as uvicorn. Heroku: add a worker dyno (see repo root Procfile).
# Delayed Gmail needs a Google refresh_token on login (encrypted at rest using JWT_SECRET).
# If Google does not return refresh_token, sign out/in with consent / offline access enabled.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default for server redirect flows. GIS popup sends the page origin as redirect_uri;
# add that origin under Authorized redirect URIs in Google Cloud (same value as token exchange).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
ANTHROPIC_API_KEY=
# Heavy model: background tasks, browser worker, web-search digests (default Sonnet)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Fast model: SMS chat, meeting summaries, profile extract (default Haiku if unset)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra origins (e.g. https://your-app.netlify.app)
ADDITIONAL_CORS_ORIGINS=
# Google OAuth: enable Drive, Docs, Sheets, Slides, Calendar, Gmail APIs in Cloud Console
# and add scopes: drive.readonly, drive.file, documents, spreadsheets, presentations,
# calendar, gmail.modify — then users re-consent after scope changes.

# --- Sendblue (optional): SMS + phone OTP + inbound chat webhook ---
# Register receive webhook URL: https://<YOUR_PUBLIC_HOST>/api/webhooks/sendblue (HTTPS).
# Inbound SMS routes to users where phone_e164 matches the sender and phone_verified_at is set
# (after web signup via POST /api/auth/phone/verify). Unknown numbers get a signup link SMS.
# SDK also reads SENDBLUE_API_API_KEY / SENDBLUE_API_API_SECRET if the shorter names are unset.
# SENDBLUE_WEBHOOK_SECRET: optional; if set, must match the secret Sendblue sends on webhooks.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
# Optional: dedicated secret for hashing SMS OTP codes (defaults to JWT_SECRET if unset).
PHONE_OTP_SECRET=

# --- MCP gateway (optional): host MCP tools like OpenTable ---
# MCP_GATEWAY_URL: base URL of the gateway service, e.g. https://ally-mcp-gateway.up.railway.app
# MCP_GATEWAY_SECRET: shared secret; gateway uses it to request decrypted sessions from /api/opentable/session
# ALLY_BACKEND_URL: set on the gateway, points back to this backend (same as Heroku URL)
MCP_GATEWAY_URL=
MCP_GATEWAY_SECRET=

# --- Apify restaurant MCP (recommended): OpenTable / Resy actors on Apify Standby ---
# Get token: https://console.apify.com/settings/integrations
# OpenTable Booker (search, availability, book, my_reservations, cancel, login, verify_otp):
#   https://apify.com/clearpath/opentable-booker
# Resy Booker (alternative): https://apify.com/clearpath/resy-booker
APIFY_TOKEN=
# Optional overrides (defaults match clearpath Standby MCP URLs):
# APIFY_OPENTABLE_MCP_URL=https://clearpath--opentable-booker.apify.actor/mcp
# APIFY_RESY_MCP_URL=https://clearpath--resy-booker.apify.actor/mcp

# --- Google Maps (optional): things_to_do_near tool (Geocoding + Places API) ---
GOOGLE_MAPS_API_KEY=
# Optional: public base for create_ally_site URLs (default FRONTEND_URL)
# ALLY_SITES_PUBLIC_BASE_URL=https://resplendent-melba-7d820a.netlify.app

# --- Meeting BaaS (optional): bot joins Meet/Zoom/Teams for notes ---
# Webhook URL (set in Meeting BaaS dashboard): https://<YOUR_HOST>/api/webhooks/meeting-baas
# Events: bot.completed + bot.failed (or legacy complete + failed)
# Meeting BaaS v2 (bot joins + notes SMS). See docs/MEETING_BAAS_SETUP.md
MEETING_BAAS_API_KEY=
BACKEND_PUBLIC_URL=
BACKEND_PUBLIC_URL=https://ally-web-backend-9e9dc3fed95b.herokuapp.com

# --- Stripe (optional): Ally Task Runner $9.99/mo + Ally $19.99/mo + Ally Pro $49.99/mo ---
# See STRIPE_SETUP.md for Dashboard steps, webhook events, and Heroku config.
# Webhook (HTTPS): https://<YOUR_HOST>/api/billing/webhook
# Checkout: POST /api/billing/checkout-session with { "plan": "task_runner" | "starter" | "pro" }
# When Stripe is configured, inbound SMS requires active/trialing subscription on any plan.
# Task Runner: 3 background automations/day. Proactive SMS and browser automation require Ally Pro.

# Optional: Hunter.io domain search (set in backend/.env)
# HUNTER_API_KEY=
# Same secret on Heroku and Railway. See docs/BROWSER_WORKER.md
ALLY_INTERNAL_SECRET=
BROWSER_WORKER_MAX_STEPS=25
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TASK_RUNNER_MONTHLY=price_1TmwbQHahLICfy6LorunK9kz
STRIPE_PRICE_STARTER_MONTHLY=price_1TdEcxHahLICfy6LjEc7fdLG
STRIPE_PRICE_PRO_MONTHLY=price_1TdEeZHahLICfy6L06cd66ql
# Legacy: if set alone, treated as the Pro price id (STRIPE_PRICE_PRO_MONTHLY preferred).
STRIPE_PRICE_SMS_MONTHLY=

# --- Waitlist (optional): notify owner when someone joins ---
# Default notify address: SENDBLUE_OWNER_EMAIL or deionstfleur13@gmail.com
# SMS fallback: WAITLIST_NOTIFY_PHONE or SENDBLUE_ALLOWED_E164 (uses Sendblue when email unset)
# Option A — Resend: https://resend.com (free tier)
# RESEND_API_KEY=
# WAITLIST_FROM_EMAIL=Ally <onboarding@yourfriendally.com>
# Option B — Gmail SMTP (use an app password, not your normal password)
# WAITLIST_SMTP_HOST=smtp.gmail.com
# WAITLIST_SMTP_PORT=587
# WAITLIST_SMTP_USER=deionstfleru13@gmail.com
# WAITLIST_SMTP_PASSWORD=
